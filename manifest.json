{
  "manifest_version": 3,
  "name": "GeckoTV Switcher",
  "version": "1.0.0",
  "description": "Automatically opens the TradingView chart on CoinGecko coin pages.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.coingecko.com/en/coins/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
